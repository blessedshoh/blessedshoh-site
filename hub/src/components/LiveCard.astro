---
// The home page's moving chart: a long call losing its time value as expiry nears,
// then winding back. Priced in the browser with Black-Scholes; purely decorative.
interface Props {
  href: string;
}
const { href } = Astro.props;
---

<a class="live-card" href={href} aria-label="Open the options risk tool">
  <div class="top"><span>Long call · strike 180</span><b data-days>30 days left</b></div>
  <div class="pl num"><span data-pl>$0</span><small>if the price stays at 166</small></div>
  <svg viewBox="0 0 480 220" role="img" aria-label="Profit of a long call shrinking toward its payoff at expiry">
    <defs>
      <clipPath id="lc-up"><rect data-clip-up x="0" y="0" width="480" height="154"></rect></clipPath>
      <clipPath id="lc-down"><rect data-clip-down x="0" y="154" width="480" height="66"></rect></clipPath>
    </defs>
    <line data-grid x1="16" x2="464" y1="70" y2="70" stroke="var(--grid)"></line>
    <line data-zero x1="16" x2="464" y1="154" y2="154" stroke="var(--muted)" stroke-opacity=".6"></line>
    <line data-spot x1="0" x2="0" y1="18" y2="206" stroke="var(--muted)" stroke-dasharray="2 4"></line>
    <path data-expiry fill="none" stroke="var(--accent)" stroke-width="1.4" stroke-dasharray="5 4"></path>
    <path data-area-up fill="var(--profit)" fill-opacity=".12" clip-path="url(#lc-up)"></path>
    <path data-area-down fill="var(--loss)" fill-opacity=".12" clip-path="url(#lc-down)"></path>
    <path data-curve-up fill="none" stroke="var(--profit)" stroke-width="2.2" stroke-linecap="round" clip-path="url(#lc-up)"></path>
    <path data-curve-down fill="none" stroke="var(--loss)" stroke-width="2.2" stroke-linecap="round" clip-path="url(#lc-down)"></path>
  </svg>
  <div class="foot"><span>Black-Scholes, priced in Python</span><span>Open the tool &rarr;</span></div>
</a>

<script>
  const card = document.querySelector<HTMLElement>(".live-card");
  if (card) {
    const S0 = 166, K = 180, VOL = 0.64, R = 0.04, T0 = 30, QTY = 1000;
    const X0 = 136, X1 = 214, Y0 = -12000, Y1 = 34000, W = 480, H = 220, L = 16, RT = 16;
    const erf = (x: number) => {
      const s = x < 0 ? -1 : 1;
      x = Math.abs(x);
      const t = 1 / (1 + 0.3275911 * x);
      return s * (1 - ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * Math.exp(-x * x));
    };
    const N = (x: number) => 0.5 * (1 + erf(x / Math.SQRT2));
    const call = (S: number, days: number) => {
      if (days <= 0.0001) return Math.max(S - K, 0);
      const T = days / 365, v = VOL * Math.sqrt(T), d1 = (Math.log(S / K) + (R + (VOL * VOL) / 2) * T) / v;
      return S * N(d1) - K * Math.exp(-R * T) * N(d1 - v);
    };
    const cost = call(S0, T0) * QTY;
    const sx = (p: number) => L + ((p - X0) / (X1 - X0)) * (W - L - RT);
    const sy = (v: number) => 18 + ((Y1 - v) / (Y1 - Y0)) * (H - 36);
    const prices: number[] = [];
    for (let i = 0; i <= 90; i++) prices.push(X0 + ((X1 - X0) * i) / 90);
    prices.push(K);
    prices.sort((a, b) => a - b);
    const path = (days: number) =>
      prices.map((p, i) => `${i ? "L" : "M"}${sx(p).toFixed(1)} ${sy(call(p, days) * QTY - cost).toFixed(1)}`).join("");

    const $ = (name: string) => card.querySelector<SVGElement & HTMLElement>(`[data-${name}]`)!;
    const set = (name: string, attrs: Record<string, string | number>) => {
      for (const [k, v] of Object.entries(attrs)) $(name).setAttribute(k, String(v));
    };
    const zero = sy(0).toFixed(1);
    set("zero", { y1: zero, y2: zero });
    set("clip-up", { height: zero });
    set("clip-down", { y: zero, height: (H - sy(0)).toFixed(1) });
    set("grid", { y1: sy(20000).toFixed(1), y2: sy(20000).toFixed(1) });
    set("expiry", { d: path(0) });
    set("spot", { x1: sx(S0), x2: sx(S0) });
    const fmt = (v: number) => {
      const r = Math.round(v);
      return r === 0 ? "$0" : `${r > 0 ? "+" : "−"}$${Math.abs(r).toLocaleString("en-US")}`;
    };

    const draw = (days: number) => {
      const d = path(days);
      const area = `${d}L${sx(X1).toFixed(1)} ${zero}L${sx(X0).toFixed(1)} ${zero}Z`;
      set("curve-up", { d });
      set("curve-down", { d });
      set("area-up", { d: area });
      set("area-down", { d: area });
      const left = Math.round(days);
      $("days").textContent = days <= 0.05 ? "Expiry" : `${left} ${left === 1 ? "day" : "days"} left`;
      $("pl").textContent = fmt(call(S0, days) * QTY - cost);
    };

    draw(T0);
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const run = 3200, hold = 900;
      let start: number | null = null;
      const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
      const frame = (now: number) => {
        start ??= now;
        const t = (now - start) % (2 * run + 2 * hold);
        let days: number;
        if (t < hold) days = T0;
        else if (t < hold + run) days = T0 * (1 - ease((t - hold) / run));
        else if (t < 2 * hold + run) days = 0;
        else days = T0 * ease((t - 2 * hold - run) / run);
        draw(days);
        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    }
  }
</script>

<style>
  .live-card {
    display: block;
    color: inherit;
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--panel);
    overflow: hidden;
    transition: border-color 0.2s, transform 0.3s;
  }
  .live-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 14px 18px 0;
    font: 500 11px/1.4 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .top b {
    font-weight: 500;
    color: var(--accent);
  }
  .pl {
    padding: 6px 18px 0;
    font-size: 28px;
    font-weight: 500;
    line-height: 1.2;
  }
  .pl small {
    font: 400 13px var(--sans);
    color: var(--muted);
    margin-left: 8px;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .foot {
    display: flex;
    justify-content: space-between;
    padding: 10px 18px 14px;
    border-top: 1px solid var(--line);
    font: 500 11px/1.4 var(--mono);
    color: var(--muted);
  }
  @media (max-width: 480px) {
    .foot span:first-child {
      display: none;
    }
    .foot {
      justify-content: flex-end;
    }
  }
</style>
