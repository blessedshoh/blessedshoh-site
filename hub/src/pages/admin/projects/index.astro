---
import { env } from "cloudflare:workers";
import { listProjects } from "@blessedshoh/kit/hub-data";
import Admin from "../../../layouts/Admin.astro";
import { deleteProject, moveProject } from "../../../lib/admin.ts";

const who = Astro.locals.admin ?? "";
const NOTICES: Record<string, string> = {
  saved: "Saved. The change is live on the home page and in every tool's header.",
  added: "Project added.",
  deleted: "Project deleted.",
};

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const id = Number(form.get("id"));
  const action = String(form.get("action"));
  if (Number.isInteger(id)) {
    if (action === "up" || action === "down") await moveProject(env.DB, who, id, action);
    if (action === "delete") {
      await deleteProject(env.DB, who, id);
      return Astro.redirect("/admin/projects?done=deleted", 303);
    }
  }
  return Astro.redirect("/admin/projects", 303);
}

const projects = await listProjects(env.DB, true);
const notice = NOTICES[Astro.url.searchParams.get("done") ?? ""] ?? null;
---

<Admin title="Projects" notice={notice}>
  <div class="bar">
    <p class="help">Cards on the home page, in this order. Live projects marked for the header also appear in every tool's project switcher.</p>
    <a class="btn solid" href="/admin/projects/new">Add project</a>
  </div>

  <section class="panel">
    {projects.length === 0 ? (
      <p class="empty">No projects yet.</p>
    ) : (
      <table>
        <thead>
          <tr><th>Order</th><th>Project</th><th>Status</th><th>Shown in</th><th></th></tr>
        </thead>
        <tbody>
          {projects.map((p, i) => (
            <tr class:list={{ hidden: p.status === "hidden" }}>
              <td class="order">
                <form method="post">
                  <input type="hidden" name="id" value={p.id} />
                  <button class="arrow" name="action" value="up" disabled={i === 0} aria-label={`Move ${p.title} up`}>↑</button>
                  <button class="arrow" name="action" value="down" disabled={i === projects.length - 1} aria-label={`Move ${p.title} down`}>↓</button>
                </form>
              </td>
              <td>
                <a class="title" href={`/admin/projects/${p.id}`}>{p.title}</a>
                <div class="sub num">{p.url ? p.url.replace(/^https:\/\//, "") : "no address yet"}</div>
              </td>
              <td><span class:list={["pill", p.status]}>{p.status}</span>{p.featured ? <span class="pill feat">featured</span> : null}</td>
              <td class="sub">{p.status === "hidden" ? "Nowhere" : p.in_header && p.status === "live" ? "Home, header" : "Home"}</td>
              <td class="end"><a class="btn" href={`/admin/projects/${p.id}`}>Edit</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </section>
</Admin>

<style>
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 18px;
  }
  .bar .help {
    margin: 0;
    max-width: 62ch;
  }
  .order form {
    display: flex;
    gap: 4px;
  }
  .arrow {
    width: 28px;
    height: 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    font-size: 13px;
  }
  .arrow:hover:not(:disabled) {
    border-color: var(--accent);
  }
  .arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .title {
    font-weight: 500;
    text-decoration: none;
  }
  .title:hover {
    color: var(--accent);
  }
  .sub {
    color: var(--muted);
    font-size: 12.5px;
  }
  tr.hidden .title {
    color: var(--muted);
  }
  .pill {
    display: inline-block;
    font: 500 10.5px/1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 7px;
    border: 1px solid var(--line);
    border-radius: 3px;
    margin-right: 6px;
    color: var(--muted);
  }
  .pill.live {
    color: var(--profit);
    border-color: color-mix(in srgb, var(--profit) 40%, transparent);
  }
  .pill.feat {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .end {
    text-align: right;
  }
  @media (max-width: 760px) {
    .bar {
      flex-direction: column;
      align-items: flex-start;
    }
    th:nth-child(4),
    td:nth-child(4) {
      display: none;
    }
  }
</style>
