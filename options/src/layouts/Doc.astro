---
// Reading pages for the options tool: methodology and model limits.
import { env } from "cloudflare:workers";
import { headerLinks, type HeaderLink } from "@blessedshoh/kit/hub-data";
import builtIn from "../data/settings.json";
import Base from "./Base.astro";

interface Props {
  title: string;
  description: string;
  kicker: string;
  lede: string;
  sections: { id: string; title: string }[];
}

const { title, description, kicker, lede, sections } = Astro.props;
let links: HeaderLink[] = builtIn.projects;
try {
  const fromHub = await headerLinks(env.DB, "options");
  if (fromHub.length > 0) links = fromHub.map((link) => ({ ...link, current: false }));
} catch {
  // The built-in list will do.
}
const here = Astro.url.pathname;
---

<Base title={`${title} · Options risk tool · blessedshoh`} description={description} links={links} theme="paper">
  <div class="doc wrap">
    <aside>
      <a class="back" href="/">&larr; Back to the tool</a>
      <nav aria-label="On this page">
        <span class="k">On this page</span>
        {sections.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
      </nav>
      <nav aria-label="About the tool">
        <span class="k">About the tool</span>
        <a href="/methodology" aria-current={here === "/methodology" ? "page" : undefined}>Methodology</a>
        <a href="/limits" aria-current={here === "/limits" ? "page" : undefined}>Where the model is wrong</a>
        <a href="https://github.com/blessedshoh/quant-core">Source code</a>
      </nav>
    </aside>
    <article>
      <div class="kicker">{kicker}</div>
      <h1>{title}</h1>
      <p class="lede">{lede}</p>
      <slot />
    </article>
  </div>
</Base>

<style>
  .doc {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 56px;
    padding-top: 44px;
    padding-bottom: 96px;
  }
  aside {
    position: sticky;
    top: 24px;
    align-self: start;
    display: grid;
    gap: 26px;
    font-size: 13.5px;
  }
  aside nav {
    display: grid;
    gap: 7px;
  }
  aside a {
    color: var(--soft);
    text-decoration: none;
  }
  aside a:hover,
  aside a[aria-current="page"] {
    color: var(--ink);
  }
  aside a[aria-current="page"] {
    font-weight: 600;
  }
  .back {
    font: 500 12px/1 var(--mono);
    color: var(--accent) !important;
  }
  article {
    max-width: 72ch;
  }
  .kicker {
    font: 500 11.5px/1.4 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  h1 {
    font-size: clamp(34px, 4.4vw, 50px);
    font-weight: 500;
    letter-spacing: -0.025em;
    margin: 12px 0 16px;
  }
  .lede {
    font-size: 18px;
    color: var(--soft);
    margin: 0 0 12px;
  }
  article :global(h2) {
    font-size: 27px;
    font-weight: 500;
    margin: 52px 0 12px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    scroll-margin-top: 20px;
  }
  article :global(h3) {
    font-size: 19px;
    font-weight: 600;
    margin: 28px 0 6px;
  }
  article :global(p),
  article :global(li) {
    color: var(--soft);
    font-size: 16px;
  }
  article :global(p) {
    margin: 10px 0;
  }
  article :global(ul),
  article :global(ol) {
    padding-left: 22px;
  }
  article :global(li) {
    margin: 6px 0;
  }
  article :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
  article :global(pre) {
    font: 400 13.5px/1.7 var(--mono);
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    background: var(--panel);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    padding: 12px 16px;
    overflow-x: auto;
    margin: 14px 0;
  }
  article :global(code) {
    font: 400 0.9em var(--mono);
    color: var(--ink);
  }
  article :global(.where) {
    font-size: 13.5px;
    color: var(--muted);
  }
  article :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 14.5px;
    margin: 14px 0;
  }
  article :global(th) {
    text-align: left;
    font: 500 10.5px/1.4 var(--mono);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0 12px 8px 0;
    border-bottom: 1px solid var(--line);
  }
  article :global(td) {
    padding: 9px 12px 9px 0;
    border-bottom: 1px solid var(--grid);
    vertical-align: top;
    color: var(--soft);
  }
  article :global(.limit) {
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 16px 20px 6px;
    margin: 16px 0;
    background: var(--panel);
  }
  article :global(.limit h3) {
    margin-top: 0;
  }
  article :global(.limit .tag) {
    display: inline-block;
    font: 500 10.5px/1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 6px;
    border-radius: 3px;
    margin-bottom: 8px;
    color: var(--loss);
    border: 1px solid color-mix(in srgb, var(--loss) 40%, transparent);
  }
  article :global(.limit .tag.mild) {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }
  article :global(.fix) {
    font-size: 14.5px;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .doc {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding-top: 24px;
    }
    aside {
      position: static;
    }
    aside nav[aria-label="On this page"] {
      display: none;
    }
  }
</style>
