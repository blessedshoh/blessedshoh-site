// The options tool on Cloudflare: static files only, no server code.
// Deploy from this folder:  pnpm run deploy
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blessedshoh-options",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist" },
  // Cloudflare creates the DNS record and certificate for this address itself.
  "routes": [{ "pattern": "options.blessedshoh.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false
}
