// The options tool on Cloudflare. Static files are served as they are; the page itself
// is rendered per visit from the hub database (settings, default example, header links).
// Deploy from this folder:  pnpm run deploy
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blessedshoh-options",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The hub's database. Its tables are created and changed from the hub folder only.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blessedshoh-hub",
      "database_id": "63423783-b380-42da-8d64-2b994eec20eb"
    }
  ],
  // Cloudflare creates the DNS record and certificate for this address itself.
  "routes": [{ "pattern": "options.blessedshoh.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": true }
}
